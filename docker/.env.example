# Copy this file to .env (in this same docker/ folder) to set a default
# port without typing PORT=... every time:
#
#   cp .env.example .env
#
# Then just run:
#
#   docker compose up --build -d
#
PORT=8000

# Interface language: "en" (English, LTR) or "fa" (Persian, RTL).
APP_LANG=en

# First run only (empty database). Empty = random password, printed in
# `docker logs pyshiny` and saved to db/initial_superadmin_password.txt.
INITIAL_SUPERADMIN_PASSWORD=
# 1 = also create the demo accounts admin / user / guest (testing only).
DEMO_ACCOUNTS=0
# A signed-in session ends after this many hours (0 = no limit).
SESSION_MAX_HOURS=12
# 1 only when a reverse proxy you control sets X-Forwarded-For.
TRUST_PROXY_HEADERS=0
# 1 only when the site is served over HTTPS.
HSTS=0
